# Sao chép file này thành .env.development (dev) hoặc set trực tiếp trên
# dashboard của Render/host khi deploy. KHÔNG điền secret thật vào file này.

NODE_ENV=development
PORT=5000

# Local dev qua docker-compose: dùng tên service nội bộ (mongodb, redis).
# Production: thay bằng connection string của MongoDB Atlas / Redis Cloud.
MONGODB_URI=mongodb://mongodb:27017/ecommerce?replicaSet=rs0
REDIS_URL=redis://redis:6379

LOG_LEVEL=debug
LOG_DIR=logs
LOG_TO_FILE=true

# Khóa HMAC để hash OTP — sinh bằng: openssl rand -hex 32
OTP_SECRET=
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM="Ecommerce <no-reply@yourdomain.com>"

# Chỉ dùng cho cụm MySQL master/slave trong docker-compose (sandbox học tập)
MYSQL_ROOT_PASSWORD=root
